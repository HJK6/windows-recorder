aws/.terraform.lock.hcl
aws/build/
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
**/*.tfvars
crash.log
# Local secrets / env / evidence — keep out of the public repo
.env
*.env
secrets/
evidence/
*.pem
*.key
